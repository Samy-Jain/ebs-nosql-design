graph EBS_After_BCNF {
  graph [rankdir=TB, splines=ortho, nodesep=0.6, ranksep=0.8,
         fontname="Arial",
         label="EBS — After Normalization (BCNF)\nWeak Entities · Self-Reference · M:N Resolved · Denorm Noted",
         labelloc=t, fontsize=16]
  node [fontname="Arial", fontsize=11]
  edge [fontname="Arial", fontsize=10]

  node [shape=rectangle, style=filled, fillcolor="#EEF6FF",
        color="#1A4A99", penwidth=2]

  USER
  SELLER
  CATEGORY
  PRODUCT
  CART
  ORDER
  REVIEW
  PAYMENT
  USER_ADDRESS
  PRODUCT_IMAGE

  node [shape=rectangle, style=filled, fillcolor="#FFF0F5",
        color="#993366", penwidth=2, peripheries=2]

  PRODUCT_VARIANT
  ORDER_ITEM

  node [shape=rectangle, style=filled, fillcolor="#F0FFF0",
        color="#226622", penwidth=2, peripheries=1]

  CART_ITEM

  node [shape=ellipse, style=filled, fillcolor="#F0F0FF",
        color="#445588", penwidth=1.2, peripheries=1]

  u_id      [label="user_id\n(PK)", style="filled,bold"]
  u_name    [label="name"]
  u_email   [label="email\n(UK, CK)"]
  u_phone   [label="phone"]
  u_pwd     [label="password_hash"]
  u_cat     [label="created_at"]

  ua_id     [label="address_id\n(PK)", style="filled,bold"]
  ua_uid    [label="user_id\n(FK)"]
  ua_line1  [label="line1"]
  ua_city   [label="city"]
  ua_state  [label="state"]
  ua_pin    [label="pincode"]
  ua_def    [label="is_default"]

  s_id      [label="seller_id\n(PK)", style="filled,bold"]
  s_bname   [label="business_name"]
  s_email   [label="email\n(UK, CK)"]
  s_phone   [label="phone"]
  s_gst     [label="gst_number\n(UK, CK)"]
  s_rating  [label="rating"]
  s_joined  [label="joined_at"]

  c_id      [label="category_id\n(PK)", style="filled,bold"]
  c_name    [label="category_name\n(UK, CK)"]
  c_parent  [label="parent_id\n(FK, self-ref, nullable)"]
  c_desc    [label="description"]

  p_id      [label="product_id\n(PK)", style="filled,bold"]
  p_sid     [label="seller_id\n(FK)"]
  p_cid     [label="category_id\n(FK)"]
  p_name    [label="name"]
  p_desc    [label="description"]
  p_price   [label="price"]
  p_disc    [label="discount"]
  p_stock   [label="stock_quantity"]
  p_rating  [label="average_rating"]
  p_cat     [label="created_at"]

  pv_vid    [label="variant_id\n(PK partial)", style="filled,bold"]
  pv_pid    [label="product_id\n(PK + FK)", style="filled,bold"]
  pv_size   [label="size"]
  pv_col    [label="colour"]
  pv_stor   [label="storage"]
  pv_aprice [label="additional_price"]
  pv_stock  [label="stock"]

  pi_id     [label="image_id\n(PK)", style="filled,bold"]
  pi_pid    [label="product_id\n(FK)"]
  pi_url    [label="image_url"]
  pi_ord    [label="display_order"]

  ca_id     [label="cart_id\n(PK)", style="filled,bold"]
  ca_uid    [label="user_id\n(FK, UNIQUE)"]
  ca_upd    [label="updated_at"]

  ci_cid    [label="cart_id\n(PK + FK)", style="filled,bold"]
  ci_pid    [label="product_id\n(PK + FK)", style="filled,bold"]
  ci_qty    [label="quantity"]
  ci_added  [label="added_at"]

  o_id      [label="order_id\n(PK)", style="filled,bold"]
  o_uid     [label="user_id\n(FK)"]
  o_status  [label="order_status"]
  o_amt     [label="total_amount"]
  o_placed  [label="placed_at"]
  o_deliv   [label="delivered_at"]

  oi_oid    [label="order_id\n(PK + FK)", style="filled,bold"]
  oi_iid    [label="item_id\n(PK partial)", style="filled,bold"]
  oi_pid    [label="product_id\n(soft-ref, snapshot)"]
  oi_sid    [label="seller_id\n(snapshot)"]
  oi_pname  [label="product_name\n(snapshot)"]
  oi_qty    [label="quantity"]
  oi_price  [label="unit_price\n(snapshot)"]

  r_id      [label="review_id\n(PK)", style="filled,bold"]
  r_pid     [label="product_id\n(FK)"]
  r_uid     [label="user_id\n(FK)"]
  r_rating  [label="rating"]
  r_title   [label="title"]
  r_body    [label="body"]
  r_ver     [label="verified"]
  r_cat     [label="created_at"]

  pay_id    [label="payment_id\n(PK)", style="filled,bold"]
  pay_oid   [label="order_id\n(FK, UNIQUE, CK)"]
  pay_uid   [label="user_id\n(denorm. via order_id)"]
  pay_amt   [label="amount"]
  pay_meth  [label="method"]
  pay_txn   [label="transaction_id\n(UK, CK)"]
  pay_stat  [label="payment_status"]
  pay_date  [label="paid_at"]

  node [shape=diamond, style=filled, fillcolor="#FFE8F8",
        color="#993366", penwidth=2, fontsize=11, peripheries=2]

  HasVariant  [label="Has Variant\n1:N"]
  Contains_OI [label="Contains\n1:N min 1"]

  node [shape=diamond, style=filled, fillcolor="#E8F8E8",
        color="#226622", penwidth=2, fontsize=11, peripheries=1]

  Has_Addr     [label="Has\n1:N"]
  Has_Img      [label="Has Image\n1:N"]
  Has_Cart     [label="Has\n1:1"]
  Places       [label="Places\n1:N"]
  Writes       [label="Writes\n1:N"]
  Makes        [label="Makes\n1:N\n[denorm.]"]
  Lists        [label="Lists\n1:N"]
  SubCatOf     [label="SubCategory Of\n0or1:N"]
  Classifies   [label="Classifies\n1:N"]
  Receives     [label="Receives\n1:N"]
  IncludedIn   [label="Included In\n1:N"]
  ReferencedIn [label="Referenced In\n1:N"]
  Holds        [label="Holds\n1:N"]
  SettledBy    [label="Settled By\n1:1"]

  USER -- u_id
  USER -- u_name
  USER -- u_email
  USER -- u_phone
  USER -- u_pwd
  USER -- u_cat

  USER_ADDRESS -- ua_id
  USER_ADDRESS -- ua_uid
  USER_ADDRESS -- ua_line1
  USER_ADDRESS -- ua_city
  USER_ADDRESS -- ua_state
  USER_ADDRESS -- ua_pin
  USER_ADDRESS -- ua_def

  SELLER -- s_id
  SELLER -- s_bname
  SELLER -- s_email
  SELLER -- s_phone
  SELLER -- s_gst
  SELLER -- s_rating
  SELLER -- s_joined

  CATEGORY -- c_id
  CATEGORY -- c_name
  CATEGORY -- c_parent
  CATEGORY -- c_desc

  PRODUCT -- p_id
  PRODUCT -- p_sid
  PRODUCT -- p_cid
  PRODUCT -- p_name
  PRODUCT -- p_desc
  PRODUCT -- p_price
  PRODUCT -- p_disc
  PRODUCT -- p_stock
  PRODUCT -- p_rating
  PRODUCT -- p_cat

  PRODUCT_VARIANT -- pv_vid
  PRODUCT_VARIANT -- pv_pid
  PRODUCT_VARIANT -- pv_size
  PRODUCT_VARIANT -- pv_col
  PRODUCT_VARIANT -- pv_stor
  PRODUCT_VARIANT -- pv_aprice
  PRODUCT_VARIANT -- pv_stock

  PRODUCT_IMAGE -- pi_id
  PRODUCT_IMAGE -- pi_pid
  PRODUCT_IMAGE -- pi_url
  PRODUCT_IMAGE -- pi_ord

  CART -- ca_id
  CART -- ca_uid
  CART -- ca_upd

  CART_ITEM -- ci_cid
  CART_ITEM -- ci_pid
  CART_ITEM -- ci_qty
  CART_ITEM -- ci_added

  ORDER -- o_id
  ORDER -- o_uid
  ORDER -- o_status
  ORDER -- o_amt
  ORDER -- o_placed
  ORDER -- o_deliv

  ORDER_ITEM -- oi_oid
  ORDER_ITEM -- oi_iid
  ORDER_ITEM -- oi_pid
  ORDER_ITEM -- oi_sid
  ORDER_ITEM -- oi_pname
  ORDER_ITEM -- oi_qty
  ORDER_ITEM -- oi_price

  REVIEW -- r_id
  REVIEW -- r_pid
  REVIEW -- r_uid
  REVIEW -- r_rating
  REVIEW -- r_title
  REVIEW -- r_body
  REVIEW -- r_ver
  REVIEW -- r_cat

  PAYMENT -- pay_id
  PAYMENT -- pay_oid
  PAYMENT -- pay_uid
  PAYMENT -- pay_amt
  PAYMENT -- pay_meth
  PAYMENT -- pay_txn
  PAYMENT -- pay_stat
  PAYMENT -- pay_date

  USER     -- Has_Addr;     Has_Addr     -- USER_ADDRESS
  USER     -- Has_Cart;     Has_Cart     -- CART
  USER     -- Places;       Places       -- ORDER
  USER     -- Writes;       Writes       -- REVIEW
  USER     -- Makes;        Makes        -- PAYMENT

  SELLER   -- Lists;        Lists        -- PRODUCT

  CATEGORY -- SubCatOf;     SubCatOf     -- CATEGORY
  CATEGORY -- Classifies;   Classifies   -- PRODUCT

  PRODUCT  -- HasVariant;   HasVariant   -- PRODUCT_VARIANT
  PRODUCT  -- Has_Img;      Has_Img      -- PRODUCT_IMAGE
  PRODUCT  -- Receives;     Receives     -- REVIEW
  PRODUCT  -- IncludedIn;   IncludedIn   -- CART_ITEM
  PRODUCT  -- ReferencedIn; ReferencedIn -- ORDER_ITEM

  CART     -- Holds;        Holds        -- CART_ITEM

  ORDER    -- Contains_OI;  Contains_OI  -- ORDER_ITEM
  ORDER    -- SettledBy;    SettledBy    -- PAYMENT

  node [shape=plaintext, fillcolor=none, color=none, peripheries=1]
  legend [label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="4" BGCOLOR="#FFFFF0">
      <TR><TD ALIGN="LEFT"><B>Legend</B></TD></TR>
      <TR><TD ALIGN="LEFT">Rectangle (blue) = strong entity</TD></TR>
      <TR><TD ALIGN="LEFT">Double rectangle (pink) = weak entity</TD></TR>
      <TR><TD ALIGN="LEFT">Rectangle (green) = junction table (M:N resolved)</TD></TR>
      <TR><TD ALIGN="LEFT">Diamond (green) = relationship</TD></TR>
      <TR><TD ALIGN="LEFT">Double diamond (pink) = identifying relationship</TD></TR>
      <TR><TD ALIGN="LEFT">Bold ellipse = key attribute</TD></TR>
      <TR><TD ALIGN="LEFT">UK = unique key · CK = candidate key</TD></TR>
    </TABLE>
  >]
}
